# ==============================================================================
# Telegram Automation Bot - Environment Configuration
# Copy this file to .env and replace placeholder values with your actual secrets.
# NEVER commit your real .env file to source control.
# ==============================================================================

# --- Telegram Bot Configuration ---
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567
# Channel ID (numeric format e.g. -1001234567890 or @channel_username)
TELEGRAM_CHANNEL_ID=@your_channel_username
# Comma-separated list of Telegram User IDs authorized to access admin commands
ADMIN_USER_IDS=123456789,987654321

# --- Storage Provider Selection ---
# Supported providers: "local", "terabox", "s3"
STORAGE_PROVIDER=local

# --- Local Storage Provider Configuration (for public domain / self-owned local media) ---
LOCAL_STORAGE_PATH=./media_storage
# Base URL for public web access to authorized local share links (optional, e.g. https://cdn.example.com/videos)
LOCAL_STORAGE_BASE_URL=https://storage.example.com/videos

# --- TeraBox Official Open Platform Configuration ---
# Credentials obtained from official TeraBox Open Developer Platform
# Note: Integration strictly uses official developer API/webhook endpoints.
TERABOX_APP_ID=
TERABOX_APP_KEY=
TERABOX_ACCESS_TOKEN=
TERABOX_ROOT_FOLDER=/MyPublicDomainVideos
TERABOX_WEBHOOK_SECRET=

# --- S3 Compatible Storage Configuration (AWS S3, MinIO, Cloudflare R2) ---
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1

# --- Movie Metadata API Configuration ---
# TMDB API Key (The Movie Database - https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
# OMDB API Key (Open Movie Database - https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=
# Default language for metadata retrieval (ISO 639-1)
METADATA_LANGUAGE=en

# --- Database Configuration ---
# SQLite with async driver (creates database file automatically)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# --- Scheduler & Detection Configuration ---
# Interval in seconds between periodic storage scan runs (e.g. 300 = 5 minutes)
SYNC_INTERVAL_SECONDS=300
# Run an immediate storage sync on application startup (true/false)
RUN_SYNC_ON_STARTUP=true

# --- Publishing & Content Policy Settings ---
# Safety control: whether to upload video binaries directly to Telegram.
# MUST be false unless you explicitly own full distribution rights to the files.
ENABLE_DIRECT_VIDEO_UPLOAD=false
# Delay in seconds between channel posts to prevent Telegram flood limits
POST_RATE_LIMIT_DELAY=3.0
# Maximum retry attempts for failed Telegram publish calls
MAX_PUBLISH_RETRIES=3

# --- Health Check & Webhook Server ---
HEALTH_CHECK_HOST=0.0.0.0
HEALTH_CHECK_PORT=8080

# --- Logging Configuration ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/bot.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
